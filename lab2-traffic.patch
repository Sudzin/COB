diff --git a/src/core/pcap/aggregateFlows.js b/src/core/pcap/aggregateFlows.js
new file mode 100644
index 0000000..956ee6d
--- /dev/null
+++ b/src/core/pcap/aggregateFlows.js
@@ -0,0 +1,64 @@
+const { normalizeFlowKey } = require('./normalizeFlowKey');
+
+/**
+ * Накапливает статистику по потокам (вместо вывода каждого пакета).
+ * Ключ — пятёрка (IP_src, IP_dst, Port_src, Port_dst, Protocol), нормализованная так,
+ * что A→B и B→A попадают в один поток. «Инициатор» — отправитель первого увиденного пакета.
+ * @param {Iterable} packets  результат parsePacket
+ * @returns {Map<string, object>}
+ */
+function aggregateFlows(packets) {
+  const flows = new Map();
+
+  for (const pkt of packets) {
+    const key = normalizeFlowKey(pkt);
+    let f = flows.get(key);
+    if (!f) {
+      f = {
+        key,
+        proto: pkt.proto,
+        initiator: { ip: pkt.src, port: pkt.sport },
+        responder: { ip: pkt.dst, port: pkt.dport },
+        packets: 0,
+        bytes: 0,
+        start_time: pkt.ts,
+        end_time: pkt.ts,
+        max_size: 0,
+        fwd: { packets: 0, bytes: 0 }, // инициатор → ответчик
+        rev: { packets: 0, bytes: 0 }, // ответчик → инициатор
+        syn_count: 0,
+        ack_count: 0,
+        rst_count: 0,
+        fin_count: 0,
+        psh_count: 0,
+        icmp_types: {}
+      };
+      flows.set(key, f);
+    }
+
+    const forward = pkt.src === f.initiator.ip && pkt.sport === f.initiator.port;
+    const dir = forward ? f.fwd : f.rev;
+    dir.packets++;
+    dir.bytes += pkt.len;
+
+    f.packets++;
+    f.bytes += pkt.len;
+    if (pkt.ts < f.start_time) f.start_time = pkt.ts;
+    if (pkt.ts > f.end_time) f.end_time = pkt.ts;
+    if (pkt.len > f.max_size) f.max_size = pkt.len;
+
+    if (pkt.flags.syn) f.syn_count++;
+    if (pkt.flags.ack) f.ack_count++;
+    if (pkt.flags.rst) f.rst_count++;
+    if (pkt.flags.fin) f.fin_count++;
+    if (pkt.flags.psh) f.psh_count++;
+
+    if (pkt.icmpType !== null) {
+      f.icmp_types[pkt.icmpType] = (f.icmp_types[pkt.icmpType] || 0) + 1;
+    }
+  }
+
+  return flows;
+}
+
+module.exports = { aggregateFlows };
diff --git a/src/core/pcap/analyzePcap.js b/src/core/pcap/analyzePcap.js
new file mode 100644
index 0000000..cdb1cd2
--- /dev/null
+++ b/src/core/pcap/analyzePcap.js
@@ -0,0 +1,106 @@
+const { parsePcap } = require('./parsePcap');
+const { parsePacket } = require('./parsePacket');
+const { aggregateFlows } = require('./aggregateFlows');
+const { computeFlowMetrics } = require('./computeFlowMetrics');
+const { classifyFlows } = require('./classifyFlows');
+
+const CATEGORIES = ['legit', 'scan', 'synflood', 'icmp'];
+
+/** Равномерно прореживает массив до max элементов (для ответа API). */
+function sample(arr, max) {
+  if (arr.length <= max) return arr;
+  const step = Math.ceil(arr.length / max);
+  return arr.filter((_, i) => i % step === 0);
+}
+
+function serializeFlow(f) {
+  const m = f.metrics;
+  return {
+    key: f.key,
+    proto: f.proto,
+    src: f.initiator.ip, sport: f.initiator.port,
+    dst: f.responder.ip, dport: f.responder.port,
+    packets: f.packets, bytes: f.bytes,
+    start_time: f.start_time, end_time: f.end_time,
+    fwd: f.fwd, rev: f.rev,
+    syn_count: f.syn_count, ack_count: f.ack_count, rst_count: f.rst_count,
+    fin_count: f.fin_count, psh_count: f.psh_count,
+    max_size: f.max_size,
+    duration: m.duration, pps: m.pps, bps: m.bps,
+    syn_ratio: m.syn_ratio, avg_size: m.avg_size,
+    category: f.category, reasons: f.reasons
+  };
+}
+
+/**
+ * Полный анализ одного .pcap: разбор → потоки → метрики → классификация → данные для графиков.
+ * Знает только про Buffer, не про HTTP и файловую систему.
+ */
+function analyzePcap(buffer, fileName, cfg) {
+  const { linkType, packets: rawPackets, truncated } = parsePcap(buffer);
+
+  const packets = [];
+  for (const raw of rawPackets) {
+    const p = parsePacket(raw, linkType);
+    if (p) packets.push(p);
+  }
+
+  const flowList = [...aggregateFlows(packets).values()];
+  flowList.forEach(f => { f.metrics = computeFlowMetrics(f, cfg.MIN_DURATION_SEC); });
+  const incidents = classifyFlows(flowList, cfg);
+
+  // сводка по категориям (до обрезки списка потоков)
+  const categories = {};
+  CATEGORIES.forEach(c => { categories[c] = { flows: 0, packets: 0, bytes: 0 }; });
+  flowList.forEach(f => {
+    const c = categories[f.category];
+    c.flows++; c.packets += f.packets; c.bytes += f.bytes;
+  });
+
+  // счётчики для диаграмм
+  const protocols = { TCP: 0, UDP: 0, ICMP: 0 };
+  const flags = { SYN: 0, ACK: 0, PSH: 0, RST: 0, FIN: 0 };
+  flowList.forEach(f => {
+    protocols[f.proto] += f.packets;
+    flags.SYN += f.syn_count; flags.ACK += f.ack_count; flags.PSH += f.psh_count;
+    flags.RST += f.rst_count; flags.FIN += f.fin_count;
+  });
+
+  const t0 = packets.length ? Math.min(...packets.map(p => p.ts)) : 0;
+  const t1 = packets.length ? Math.max(...packets.map(p => p.ts)) : 0;
+  const totalBytes = packets.reduce((acc, p) => acc + p.len, 0);
+
+  const sizes = sample(packets.map(p => p.len), cfg.MAX_POINTS);
+  const timeline = sample(packets, cfg.MAX_POINTS).map(p => ({ t: p.ts - t0, size: p.len, proto: p.proto }));
+
+  const flows = flowList
+    .slice()
+    .sort((a, b) => b.packets - a.packets || b.bytes - a.bytes)
+    .slice(0, cfg.MAX_FLOWS)
+    .map(serializeFlow);
+
+  return {
+    fileName,
+    status: 'OK',
+    linkType,
+    truncated,
+    totalRecords: rawPackets.length,
+    totalPackets: packets.length,
+    ignoredPackets: rawPackets.length - packets.length,
+    totalBytes,
+    totalFlows: flowList.length,
+    flowsTruncated: flowList.length > flows.length,
+    t0,
+    duration: t1 - t0,
+    protocols,
+    flags,
+    categories,
+    incidents,
+    sizes,
+    timeline,
+    sampled: packets.length > cfg.MAX_POINTS,
+    flows
+  };
+}
+
+module.exports = { analyzePcap };
diff --git a/src/core/pcap/classifyFlows.js b/src/core/pcap/classifyFlows.js
new file mode 100644
index 0000000..55a603f
--- /dev/null
+++ b/src/core/pcap/classifyFlows.js
@@ -0,0 +1,129 @@
+const ICMP_TYPE_NAMES = {
+  0: 'Echo Reply', 3: 'Destination Unreachable', 4: 'Source Quench', 5: 'Redirect',
+  8: 'Echo Request', 9: 'Router Advertisement', 11: 'Time Exceeded', 13: 'Timestamp', 17: 'Address Mask'
+};
+
+const isBroadcast = ip => ip === '255.255.255.255' || ip.endsWith('.255');
+
+function groupBy(items, keyFn) {
+  const map = new Map();
+  for (const it of items) {
+    const k = keyFn(it);
+    if (!map.has(k)) map.set(k, []);
+    map.get(k).push(it);
+  }
+  return map;
+}
+
+function sum(items, field) {
+  return items.reduce((acc, it) => acc + it[field], 0);
+}
+
+function span(items) {
+  return {
+    start_time: Math.min(...items.map(f => f.start_time)),
+    end_time: Math.max(...items.map(f => f.end_time))
+  };
+}
+
+/**
+ * Эвристическая классификация потоков. Каждому потоку ставит category и reasons:
+ *   legit | scan | synflood | icmp
+ * и возвращает список инцидентов (по одному на найденную атаку/аномалию).
+ * Пороги — в config.TRAFFIC.
+ */
+function classifyFlows(flows, cfg) {
+  const incidents = [];
+  flows.forEach(f => { f.category = 'legit'; f.reasons = []; });
+
+  // 1. Сканирование портов: один источник → один узел, много РАЗНЫХ портов, на каждый 1–2 пакета без ACK
+  const probes = flows.filter(f =>
+    f.proto === 'TCP' && f.syn_count > 0 && f.ack_count === 0 && f.packets <= cfg.SCAN_MAX_PKTS_PER_PORT);
+  for (const group of groupBy(probes, f => f.initiator.ip + '>' + f.responder.ip).values()) {
+    const ports = [...new Set(group.map(f => f.responder.port))].sort((a, b) => a - b);
+    if (ports.length < cfg.SCAN_MIN_PORTS) continue;
+    const first = group[0];
+    const sequential = ports[ports.length - 1] - ports[0] + 1 === ports.length;
+    group.forEach(f => {
+      f.category = 'scan';
+      f.reasons = ['Один SYN на порт, всего ' + ports.length + ' портов узла ' + first.responder.ip];
+    });
+    incidents.push({
+      type: 'scan',
+      title: 'Сканирование портов',
+      src: first.initiator.ip,
+      dst: first.responder.ip,
+      description: `${first.initiator.ip} отправил SYN на ${ports.length} разных портов узла ${first.responder.ip} ` +
+        `(${ports[0]}–${ports[ports.length - 1]}${sequential ? ', подряд' : ''}), по ${Math.max(...group.map(f => f.packets))} пакету на порт, без завершения соединений.`,
+      flows: group.length,
+      packets: sum(group, 'packets'),
+      ...span(group)
+    });
+  }
+
+  // 2. SYN-флуд: много SYN без ACK на один порт (от многих источников или просто очень много)
+  const halfOpen = flows.filter(f =>
+    f.category === 'legit' && f.proto === 'TCP' && f.syn_count > 0 && f.ack_count === 0);
+  for (const group of groupBy(halfOpen, f => f.responder.ip + ':' + f.responder.port).values()) {
+    const sources = [...new Set(group.map(f => f.initiator.ip))];
+    const synPackets = sum(group, 'syn_count');
+    if (sources.length < cfg.FLOOD_MIN_SOURCES && synPackets < cfg.FLOOD_MIN_PACKETS) continue;
+    const first = group[0];
+    const t = span(group);
+    group.forEach(f => {
+      f.category = 'synflood';
+      f.reasons = ['SYN без ACK на ' + first.responder.ip + ':' + first.responder.port + ', источников: ' + sources.length];
+    });
+    incidents.push({
+      type: 'synflood',
+      title: 'SYN-флуд (DoS)',
+      src: sources.length > 1 ? sources.length + ' источников' : sources[0],
+      dst: first.responder.ip + ':' + first.responder.port,
+      sources: sources.slice(0, 5),
+      sources_count: sources.length,
+      description: `${synPackets} SYN-пакетов без единого ACK на ${first.responder.ip}:${first.responder.port} ` +
+        `от ${sources.length} источник(ов); соединения не завершаются.`,
+      flows: group.length,
+      packets: sum(group, 'packets'),
+      ...t
+    });
+  }
+
+  // 3. Аномалии ICMP
+  for (const f of flows.filter(x => x.proto === 'ICMP')) {
+    const reasons = [];
+    const types = Object.keys(f.icmp_types).map(Number);
+    if ((isBroadcast(f.initiator.ip) || isBroadcast(f.responder.ip)) && f.icmp_types[8]) {
+      reasons.push('echo-запросы на broadcast-адрес (возможен smurf-приём)');
+    }
+    if (f.max_size > cfg.ICMP_BIG_SIZE) {
+      reasons.push('необычно крупные пакеты: до ' + f.max_size + ' байт');
+    }
+    const odd = types.filter(t => !cfg.ICMP_NORMAL_TYPES.includes(t));
+    if (odd.length) {
+      reasons.push('нестандартные типы: ' + odd.map(t => t + ' (' + (ICMP_TYPE_NAMES[t] || '?') + ')').join(', '));
+    }
+    const duration = f.end_time - f.start_time;
+    if (f.packets >= cfg.ICMP_FLOOD_PACKETS && duration >= cfg.MIN_DURATION_SEC && f.packets / duration >= cfg.ICMP_FLOOD_PPS) {
+      reasons.push('высокая частота: ' + Math.round(f.packets / duration) + ' пакетов/с');
+    }
+    if (!reasons.length) continue;
+    f.category = 'icmp';
+    f.reasons = reasons;
+    incidents.push({
+      type: 'icmp',
+      title: 'Аномалия ICMP',
+      src: f.initiator.ip,
+      dst: f.responder.ip,
+      description: f.initiator.ip + ' → ' + f.responder.ip + ': ' + reasons.join('; ') + '. Пакетов: ' + f.packets + '.',
+      flows: 1,
+      packets: f.packets,
+      start_time: f.start_time,
+      end_time: f.end_time
+    });
+  }
+
+  return incidents;
+}
+
+module.exports = { classifyFlows };
diff --git a/src/core/pcap/computeFlowMetrics.js b/src/core/pcap/computeFlowMetrics.js
new file mode 100644
index 0000000..abfe507
--- /dev/null
+++ b/src/core/pcap/computeFlowMetrics.js
@@ -0,0 +1,17 @@
+/**
+ * Производные показатели потока. Если поток слишком короткий (один пакет или длительность
+ * меньше порога), PPS/BPS = null: деление на ~0 даёт миллионы «пакетов в секунду» из ничего.
+ */
+function computeFlowMetrics(flow, minDurationSec) {
+  const duration = flow.end_time - flow.start_time;
+  const reliable = flow.packets > 1 && duration >= minDurationSec;
+  return {
+    duration,
+    pps: reliable ? flow.packets / duration : null,
+    bps: reliable ? (flow.bytes * 8) / duration : null,
+    syn_ratio: flow.packets ? flow.syn_count / flow.packets : 0,
+    avg_size: flow.packets ? flow.bytes / flow.packets : 0
+  };
+}
+
+module.exports = { computeFlowMetrics };
diff --git a/src/core/pcap/normalizeFlowKey.js b/src/core/pcap/normalizeFlowKey.js
new file mode 100644
index 0000000..6006b08
--- /dev/null
+++ b/src/core/pcap/normalizeFlowKey.js
@@ -0,0 +1,20 @@
+/** "192.168.1.10" → число, чтобы упорядочивать адреса. */
+function ipToNumber(ip) {
+  return ip.split('.').reduce((acc, part) => acc * 256 + Number(part), 0);
+}
+
+/**
+ * Ключ потока для СИММЕТРИЧНОГО анализа: пакеты A→B и B→A дают один и тот же ключ.
+ * Концы (ip, порт) упорядочиваются, протокол входит в ключ.
+ * @returns {string} например "TCP|10.0.0.1:443|192.168.1.5:50000"
+ */
+function normalizeFlowKey(pkt) {
+  const a = { ip: pkt.src, port: pkt.sport };
+  const b = { ip: pkt.dst, port: pkt.dport };
+  const aFirst = ipToNumber(a.ip) < ipToNumber(b.ip) ||
+    (a.ip === b.ip && a.port <= b.port);
+  const [lo, hi] = aFirst ? [a, b] : [b, a];
+  return `${pkt.proto}|${lo.ip}:${lo.port}|${hi.ip}:${hi.port}`;
+}
+
+module.exports = { normalizeFlowKey, ipToNumber };
diff --git a/src/core/pcap/parsePacket.js b/src/core/pcap/parsePacket.js
new file mode 100644
index 0000000..cbf36f2
--- /dev/null
+++ b/src/core/pcap/parsePacket.js
@@ -0,0 +1,87 @@
+const IP_PROTO = { 1: 'ICMP', 6: 'TCP', 17: 'UDP' };
+
+/** Находит начало IPv4-заголовка в кадре, учитывая тип канального уровня. -1 — это не IPv4. */
+function findIpOffset(data, linkType) {
+  switch (linkType) {
+    case 1: { // Ethernet (+ один тег VLAN)
+      if (data.length < 14) return -1;
+      let type = data.readUInt16BE(12);
+      let off = 14;
+      if (type === 0x8100 && data.length >= 18) { type = data.readUInt16BE(16); off = 18; }
+      return type === 0x0800 ? off : -1;
+    }
+    case 0: // BSD loopback (Npcap Loopback): 4 байта семейства адресов
+      if (data.length < 4) return -1;
+      return data[0] === 2 || data[3] === 2 ? 4 : -1;
+    case 101: // Raw IP (v4 или v6 — различаем по версии)
+    case 228: // Raw IPv4
+      return data.length >= 1 && data[0] >> 4 === 4 ? 0 : -1;
+    case 113: // Linux cooked capture
+      if (data.length < 16) return -1;
+      return data.readUInt16BE(14) === 0x0800 ? 16 : -1;
+    default:
+      return -1;
+  }
+}
+
+/**
+ * Разбирает кадр. Возвращает null, если в нём нет IPv4 + TCP/UDP/ICMP (такие пакеты игнорируются).
+ * @returns {null | {ts, len, src, dst, proto, sport, dport, flags, icmpType, icmpCode}}
+ */
+function parsePacket(raw, linkType) {
+  const data = raw.data;
+  const ipOff = findIpOffset(data, linkType);
+  if (ipOff < 0 || data.length < ipOff + 20) return null;
+
+  const ihl = (data[ipOff] & 0x0f) * 4;
+  if (ihl < 20 || data.length < ipOff + ihl) return null;
+
+  const fragOffset = data.readUInt16BE(ipOff + 6) & 0x1fff;
+  if (fragOffset !== 0) return null; // не первый фрагмент: заголовка L4 в нём нет
+
+  const proto = IP_PROTO[data[ipOff + 9]];
+  if (!proto) return null;
+
+  const l4 = ipOff + ihl;
+  const pkt = {
+    ts: raw.ts,
+    len: raw.origLen,
+    src: ipToString(data, ipOff + 12),
+    dst: ipToString(data, ipOff + 16),
+    proto,
+    sport: 0,
+    dport: 0,
+    flags: { syn: false, ack: false, rst: false, fin: false, psh: false },
+    icmpType: null,
+    icmpCode: null
+  };
+
+  if (proto === 'ICMP') {
+    if (data.length < l4 + 2) return null;
+    pkt.icmpType = data[l4];
+    pkt.icmpCode = data[l4 + 1];
+    return pkt;
+  }
+
+  if (data.length < l4 + 4) return null;
+  pkt.sport = data.readUInt16BE(l4);
+  pkt.dport = data.readUInt16BE(l4 + 2);
+
+  if (proto === 'TCP' && data.length >= l4 + 14) {
+    const f = data[l4 + 13];
+    pkt.flags = {
+      fin: !!(f & 0x01),
+      syn: !!(f & 0x02),
+      rst: !!(f & 0x04),
+      psh: !!(f & 0x08),
+      ack: !!(f & 0x10)
+    };
+  }
+  return pkt;
+}
+
+function ipToString(buf, off) {
+  return buf[off] + '.' + buf[off + 1] + '.' + buf[off + 2] + '.' + buf[off + 3];
+}
+
+module.exports = { parsePacket };
diff --git a/src/core/pcap/parsePcap.js b/src/core/pcap/parsePcap.js
new file mode 100644
index 0000000..253b58a
--- /dev/null
+++ b/src/core/pcap/parsePcap.js
@@ -0,0 +1,52 @@
+/**
+ * Разбирает содержимое .pcap (классический формат libpcap) в список «сырых» пакетов.
+ * @returns {{linkType:number, packets:{ts:number, origLen:number, data:Buffer}[], truncated:boolean}}
+ * @throws Error с полем code: ERR_NOT_PCAP | ERR_PCAPNG
+ */
+function parsePcap(buffer) {
+  if (buffer.length < 24) throw makeError('ERR_NOT_PCAP', 'Файл слишком короткий для .pcap');
+
+  const magicLE = buffer.readUInt32LE(0);
+  if (magicLE === 0x0a0d0d0a) {
+    throw makeError('ERR_PCAPNG', 'Формат pcapng не поддерживается: сохраните как .pcap (Wireshark: «Сохранить как» → pcap)');
+  }
+
+  let le, nano;
+  if (magicLE === 0xa1b2c3d4) { le = true; nano = false; }
+  else if (magicLE === 0xa1b23c4d) { le = true; nano = true; }
+  else if (magicLE === 0xd4c3b2a1) { le = false; nano = false; }
+  else if (magicLE === 0x4d3cb2a1) { le = false; nano = true; }
+  else throw makeError('ERR_NOT_PCAP', 'Неизвестная сигнатура: это не .pcap');
+
+  const u32 = off => (le ? buffer.readUInt32LE(off) : buffer.readUInt32BE(off));
+  const linkType = u32(20) & 0x0fffffff; // старшие биты — флаги FCS, нам не нужны
+
+  const packets = [];
+  let off = 24;
+  let truncated = false;
+  while (off + 16 <= buffer.length) {
+    const sec = u32(off);
+    const frac = u32(off + 4);
+    const capLen = u32(off + 8);
+    const origLen = u32(off + 12);
+    off += 16;
+    if (off + capLen > buffer.length) { truncated = true; break; }
+    packets.push({
+      ts: sec + frac / (nano ? 1e9 : 1e6),
+      origLen,
+      data: buffer.subarray(off, off + capLen)
+    });
+    off += capLen;
+  }
+  if (off < buffer.length && !truncated) truncated = true; // хвост короче заголовка записи
+
+  return { linkType, packets, truncated };
+}
+
+function makeError(code, message) {
+  const e = new Error(message);
+  e.code = code;
+  return e;
+}
+
+module.exports = { parsePcap };
diff --git a/src/core/pcap/scanPcapDirectory.js b/src/core/pcap/scanPcapDirectory.js
new file mode 100644
index 0000000..72bb12a
--- /dev/null
+++ b/src/core/pcap/scanPcapDirectory.js
@@ -0,0 +1,38 @@
+const fs = require('fs');
+const path = require('path');
+const { PCAPS_DIR, PCAP_EXTENSIONS, PCAP_MAX_BYTES, TRAFFIC } = require('../../config');
+const { analyzePcap } = require('./analyzePcap');
+
+/**
+ * Сканирует папку pcaps/ и анализирует каждый .pcap. Битый файл не останавливает работу:
+ * он попадает в список со статусом CORRUPTED.
+ */
+function scanPcapDirectory() {
+  if (!fs.existsSync(PCAPS_DIR)) {
+    return { status: 'DIR_NOT_FOUND', error: 'Папка "pcaps" не найдена рядом со скриптом.', files: [] };
+  }
+
+  const names = fs.readdirSync(PCAPS_DIR)
+    .filter(f => PCAP_EXTENSIONS.includes(path.extname(f).toLowerCase()))
+    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));
+
+  if (names.length === 0) {
+    return { status: 'DIR_EMPTY', error: 'В папке "pcaps" нет файлов .pcap. Положите захваченный трафик или запустите npm run capture.', files: [] };
+  }
+
+  const files = names.map(fileName => {
+    try {
+      const filePath = path.join(PCAPS_DIR, fileName);
+      const size = fs.statSync(filePath).size;
+      if (size === 0) throw new Error('Файл пуст (0 байт)');
+      if (size > PCAP_MAX_BYTES) throw new Error('Файл слишком большой (больше ' + PCAP_MAX_BYTES / 1048576 + ' МБ)');
+      return analyzePcap(fs.readFileSync(filePath), fileName, TRAFFIC);
+    } catch (err) {
+      return { fileName, status: 'CORRUPTED', error: err.message };
+    }
+  });
+
+  return { status: 'SUCCESS', files };
+}
+
+module.exports = { scanPcapDirectory };
