diff --git a/public/js/traffic/charts/drawBars.js b/public/js/traffic/charts/drawBars.js
new file mode 100644
index 0000000..2349cce
--- /dev/null
+++ b/public/js/traffic/charts/drawBars.js
@@ -0,0 +1,38 @@
+import { esc } from '../../utils/esc.js';
+import { niceTicks } from '../../utils/niceTicks.js';
+import { noData } from './noData.js';
+
+const W = 360, H = 300, M = { l: 56, r: 12, t: 22, b: 44 };
+
+/**
+ * Столбчатая диаграмма. items: [{label, value, color}].
+ * percent: подписывать долю от суммы (для протоколов).
+ */
+export function drawBars(items, { yLabel = '', percent = false } = {}) {
+  const total = items.reduce((acc, it) => acc + it.value, 0);
+  if (!total) return noData();
+
+  const ticks = niceTicks(Math.max(...items.map(i => i.value)), 4);
+  const yMax = ticks[ticks.length - 1];
+  const pw = W - M.l - M.r, ph = H - M.t - M.b;
+  const base = M.t + ph;
+  const slot = pw / items.length;
+  const bw = Math.min(54, slot * 0.6);
+  const yOf = v => base - (v / yMax) * ph;
+
+  let g = '';
+  ticks.forEach(t => {
+    const y = yOf(t);
+    g += `<line x1="${M.l}" x2="${W - M.r}" y1="${y}" y2="${y}" class="grid"/><text x="${M.l - 6}" y="${y + 4}" text-anchor="end">${t}</text>`;
+  });
+  items.forEach((it, i) => {
+    const cx = M.l + slot * i + slot / 2, y = yOf(it.value);
+    g += `<rect x="${cx - bw / 2}" y="${y}" width="${bw}" height="${base - y}" fill="${it.color}"/>` +
+      `<text x="${cx}" y="${y - 5}" text-anchor="middle">${it.value}${percent ? ' (' + Math.round(it.value / total * 100) + '%)' : ''}</text>` +
+      `<text x="${cx}" y="${base + 16}" text-anchor="middle" class="cat">${esc(it.label)}</text>`;
+  });
+  g += `<line x1="${M.l}" x2="${M.l}" y1="${M.t}" y2="${base}" class="axis"/><line x1="${M.l}" x2="${W - M.r}" y1="${base}" y2="${base}" class="axis"/>` +
+    `<text transform="translate(13 ${M.t + ph / 2}) rotate(-90)" text-anchor="middle" class="ax-title">${esc(yLabel)}</text>`;
+
+  return `<svg viewBox="0 0 ${W} ${H}" class="chart-svg" role="img">${g}</svg>`;
+}
diff --git a/public/js/traffic/charts/drawHistogram.js b/public/js/traffic/charts/drawHistogram.js
new file mode 100644
index 0000000..20950c9
--- /dev/null
+++ b/public/js/traffic/charts/drawHistogram.js
@@ -0,0 +1,46 @@
+import { noData } from './noData.js';
+
+const W = 720, H = 320, M = { l: 64, r: 16, t: 16, b: 54 };
+
+/** Гистограмма размеров пакетов, ось Y — логарифмическая. */
+export function drawHistogram(sizes) {
+  if (!sizes.length) return noData();
+
+  let max = 0;
+  for (const s of sizes) if (s > max) max = s;
+  const BINS = 20;
+  const step = Math.max(1, Math.ceil((max + 1) / BINS));
+  const n = Math.floor(max / step) + 1;
+  const counts = new Array(n).fill(0);
+  for (const s of sizes) counts[Math.floor(s / step)]++;
+
+  const maxC = Math.max(...counts);
+  const yMin = 0.5;
+  const yTop = Math.max(10, 10 ** Math.ceil(Math.log10(maxC)));
+  const pw = W - M.l - M.r, ph = H - M.t - M.b;
+  const base = M.t + ph;
+  const yOf = c => M.t + ph * (1 - (Math.log(c) - Math.log(yMin)) / (Math.log(yTop) - Math.log(yMin)));
+  const bw = pw / n;
+
+  let g = '';
+  for (let v = 1; v <= yTop; v *= 10) {
+    const y = yOf(v);
+    g += `<line x1="${M.l}" x2="${W - M.r}" y1="${y}" y2="${y}" class="grid"/>` +
+      `<text x="${M.l - 6}" y="${y + 4}" text-anchor="end">${v}</text>`;
+  }
+  counts.forEach((c, i) => {
+    if (!c) return;
+    const x = M.l + i * bw, y = yOf(c);
+    g += `<rect x="${x + 1}" y="${y}" width="${Math.max(1, bw - 2)}" height="${base - y}" fill="#c85a28"><title>${i * step}–${(i + 1) * step - 1} Б: ${c}</title></rect>`;
+    if (bw > 20) g += `<text x="${x + bw / 2}" y="${y - 4}" text-anchor="middle">${c}</text>`;
+  });
+  const every = Math.ceil(n / 10);
+  for (let i = 0; i < n; i += every) {
+    g += `<text x="${M.l + i * bw}" y="${base + 16}" text-anchor="middle">${i * step}</text>`;
+  }
+  g += `<line x1="${M.l}" x2="${M.l}" y1="${M.t}" y2="${base}" class="axis"/><line x1="${M.l}" x2="${W - M.r}" y1="${base}" y2="${base}" class="axis"/>` +
+    `<text x="${M.l + pw / 2}" y="${H - 8}" text-anchor="middle" class="ax-title">Размер пакета (байты)</text>` +
+    `<text transform="translate(14 ${M.t + ph / 2}) rotate(-90)" text-anchor="middle" class="ax-title">Количество пакетов (log)</text>`;
+
+  return `<svg viewBox="0 0 ${W} ${H}" class="chart-svg" role="img" aria-label="Гистограмма размеров пакетов">${g}</svg>`;
+}
diff --git a/public/js/traffic/charts/drawScatter.js b/public/js/traffic/charts/drawScatter.js
new file mode 100644
index 0000000..0136aa5
--- /dev/null
+++ b/public/js/traffic/charts/drawScatter.js
@@ -0,0 +1,39 @@
+import { niceTicks } from '../../utils/niceTicks.js';
+import { PROTO_COLOR } from '../../constants.js';
+import { noData } from './noData.js';
+
+const W = 720, H = 340, M = { l: 64, r: 16, t: 28, b: 54 };
+
+/** Таймлайн: по X — время от начала захвата, по Y — размер пакета; цвет — протокол. */
+export function drawScatter(points, duration) {
+  if (!points.length) return noData();
+
+  const useMs = duration < 1;
+  const k = useMs ? 1000 : 1;
+  const unit = useMs ? 'мс' : 'с';
+  let maxT = 0, maxS = 0;
+  for (const p of points) { if (p.t > maxT) maxT = p.t; if (p.size > maxS) maxS = p.size; }
+
+  const xt = niceTicks(maxT * k || 1, 6), yt = niceTicks(maxS * 1.05, 5);
+  const xMax = xt[xt.length - 1], yMax = yt[yt.length - 1];
+  const pw = W - M.l - M.r, ph = H - M.t - M.b, base = M.t + ph;
+  const xOf = v => M.l + (v / xMax) * pw, yOf = v => base - (v / yMax) * ph;
+
+  let g = '';
+  yt.forEach(t => { g += `<line x1="${M.l}" x2="${W - M.r}" y1="${yOf(t)}" y2="${yOf(t)}" class="grid"/><text x="${M.l - 6}" y="${yOf(t) + 4}" text-anchor="end">${t}</text>`; });
+  xt.forEach(t => { g += `<text x="${xOf(t)}" y="${base + 16}" text-anchor="middle">${t}</text>`; });
+  for (const p of points) {
+    g += `<circle cx="${xOf(p.t * k).toFixed(1)}" cy="${yOf(p.size).toFixed(1)}" r="2.4" fill="${PROTO_COLOR[p.proto] || '#575952'}" fill-opacity=".6"/>`;
+  }
+  g += `<line x1="${M.l}" x2="${M.l}" y1="${M.t}" y2="${base}" class="axis"/><line x1="${M.l}" x2="${W - M.r}" y1="${base}" y2="${base}" class="axis"/>` +
+    `<text x="${M.l + pw / 2}" y="${H - 8}" text-anchor="middle" class="ax-title">Время от начала захвата (${unit})</text>` +
+    `<text transform="translate(14 ${M.t + ph / 2}) rotate(-90)" text-anchor="middle" class="ax-title">Размер пакета (байты)</text>`;
+
+  const present = [...new Set(points.map(p => p.proto))];
+  present.forEach((proto, i) => {
+    const x = W - M.r - 70 * (present.length - i);
+    g += `<circle cx="${x}" cy="12" r="4" fill="${PROTO_COLOR[proto] || '#575952'}"/><text x="${x + 8}" y="16">${proto}</text>`;
+  });
+
+  return `<svg viewBox="0 0 ${W} ${H}" class="chart-svg" role="img" aria-label="Таймлайн активности">${g}</svg>`;
+}
diff --git a/public/js/traffic/charts/drawTopFlows.js b/public/js/traffic/charts/drawTopFlows.js
new file mode 100644
index 0000000..a66e5f9
--- /dev/null
+++ b/public/js/traffic/charts/drawTopFlows.js
@@ -0,0 +1,31 @@
+import { esc } from '../../utils/esc.js';
+import { fmtNum } from '../../utils/fmtNum.js';
+import { fmtDuration } from '../../utils/fmtDuration.js';
+import { fmtEndpoint } from '../../utils/fmtEndpoint.js';
+import { CATEGORY_COLOR } from '../../constants.js';
+import { noData } from './noData.js';
+
+const W = 720, ROW = 28, LABEL_W = 250, VALUE_W = 190;
+
+/** Топ-10 самых активных потоков по числу пакетов; цвет — категория потока. */
+export function drawTopFlows(flows) {
+  const top = flows.slice().sort((a, b) => b.packets - a.packets || b.bytes - a.bytes).slice(0, 10);
+  if (!top.length) return noData();
+
+  const max = top[0].packets;
+  const barX = LABEL_W + 10, barW = W - barX - VALUE_W;
+  const H = top.length * ROW + 8;
+
+  const rows = top.map((f, i) => {
+    const y = 4 + i * ROW;
+    let label = f.proto + ' ' + fmtEndpoint(f.proto, f.src, f.sport) + ' → ' + fmtEndpoint(f.proto, f.dst, f.dport);
+    const full = label;
+    if (label.length > 40) label = label.slice(0, 39) + '…';
+    const w = Math.max(2, (f.packets / max) * barW);
+    return `<text x="${LABEL_W}" y="${y + 16}" text-anchor="end"><title>${esc(full)}</title>${esc(label)}</text>` +
+      `<rect x="${barX}" y="${y + 3}" width="${w}" height="${ROW - 8}" fill="${CATEGORY_COLOR[f.category]}"/>` +
+      `<text x="${W - 4}" y="${y + 16}" text-anchor="end">${fmtNum(f.packets)} пак · ${fmtNum(f.bytes)} Б · ${fmtDuration(f.duration)}</text>`;
+  }).join('');
+
+  return `<svg viewBox="0 0 ${W} ${H}" class="chart-svg chart-svg--top" role="img" aria-label="Топ-10 потоков">${rows}</svg>`;
+}
